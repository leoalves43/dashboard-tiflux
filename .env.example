URL_TIFLUX=https://api.tiflux.com/api/v2
TOKEN_TIFLUX=

# Postgres compartilhado (container "Postgres"); de dentro dos containers use host.docker.internal
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=dashboard
DB_PASSWORD=
DB_NAME=tiflux
SCHEMA_NAME=dashboard

# Sincronização e portas publicadas no host
SYNC_INTERVAL_MINUTES=5
WEB_PORT=8080
TZ=America/Sao_Paulo
